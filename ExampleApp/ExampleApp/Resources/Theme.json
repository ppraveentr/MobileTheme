{
    "schemaVersion": 1,
    "themeId": "example-default",
    "version": "1.0",
    "palettes": {
        "light": {
            "neutral": {
                "0": "#FFFFFF",
                "50": "#F0F2F5",
                "900": "#000000"
            },
            "brand": {
                "600": "#2673DD"
            },
            "status": {
                "success": "#44CC77"
            },
            "accent": {
                "100": "#F9DAE0"
            }
        },
        "dark": {
            "neutral": {
                "0": "#FFFFFF",
                "50": "#222222",
                "900": "#121212",
                "950": "#000000"
            },
            "brand": {
                "600": "#EE2C4A"
            },
            "status": {
                "success": "#309053"
            },
            "accent": {
                "100": "#EC455B"
            }
        }
    },
    "semantic": {
        "light": {
            "surfaceCanvas": "{palette.neutral.50}",
            "surfaceRaised": "{palette.neutral.0}",
            "surfaceSelected": "{palette.accent.100}",
            "textNeutral": "{palette.neutral.900}",
            "textBrand": "{palette.brand.600}",
            "borderSuccess": "{palette.status.success}"
        },
        "dark": {
            "surfaceCanvas": "{palette.neutral.900}",
            "surfaceRaised": "{palette.neutral.50}",
            "surfaceSelected": "{palette.accent.100}",
            "textNeutral": "{palette.neutral.0}",
            "textBrand": "{palette.brand.600}",
            "borderSuccess": "{palette.status.success}"
        }
    },
    "fonts": {
        "title": { "styleName": "title" },
        "body": { "styleName": "body" }
    },
    "borders": {
        "cardSuccess": {
            "color": "borderSuccess",
            "radius": [10, 0, 0, 10],
            "thickness": 2
        }
    },
    "backgrounds": {
        "cardSelected": {
            "color": "surfaceSelected",
            "ignoringSafeArea": false
        }
    },
    "styles": {
        "Label": {
            "Base": {
                "font": "title"
            },
            "Primary": {
                "alignment": "center",
                "font": "title",
                "border": "cardSuccess",
                "background": "cardSelected"
            },
            "Brand": {
                "font": "body"
            }
        }
    }
}
