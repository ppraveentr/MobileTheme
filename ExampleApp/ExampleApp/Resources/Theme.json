{
    "schemaVersion": 1,
    "themeId": "example-default",
    "version": "1.0",
    "palettes": {
        "light": {
            "neutral": {
                "0": "#FFFFFF",
                "50": "#F0F2F5",
                "900": "#000000"
            },
            "brand": {
                "600": "#2673DD"
            },
            "status": {
                "success": "#44CC77"
            },
            "accent": {
                "100": "#F9DAE0"
            }
        },
        "dark": {
            "neutral": {
                "0": "#FFFFFF",
                "50": "#222222",
                "900": "#121212",
                "950": "#000000"
            },
            "brand": {
                "600": "#EE2C4A"
            },
            "status": {
                "success": "#309053"
            },
            "accent": {
                "100": "#EC455B"
            }
        }
    },
    "semantic": {
        "light": {
            "surface.canvas": "{palette.neutral.50}",
            "surface.raised": "{palette.neutral.0}",
            "surface.selected": "{palette.accent.100}",
            "text.primary": "{palette.neutral.900}",
            "text.brand": "{palette.brand.600}",
            "border.success": "{palette.status.success}"
        },
        "dark": {
            "surface.canvas": "{palette.neutral.900}",
            "surface.raised": "{palette.neutral.50}",
            "surface.selected": "{palette.accent.100}",
            "text.primary": "{palette.neutral.0}",
            "text.brand": "{palette.brand.600}",
            "border.success": "{palette.status.success}"
        }
    },
    "fonts": {
        "title": { "styleName": "title" },
        "body": { "styleName": "body" }
    },
    "styles": {
        "TitleRW": {
            "forgroundColor": "text.primary",
            "alignment": "center",
            "font": "title",
            "background": {
                "color": "surface.selected",
                "border": {
                    "color": "border.success",
                    "radius": [10, 0, 0, 10],
                    "thickness": 2
                }
            }
        },
        "BodyBR": {
            "forgroundColor": "text.brand",
            "font": "body"
        }
    }
}
